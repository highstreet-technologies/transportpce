     |           |  +--ro org-openroadm-rstp:bridge-id?                bridge-id-type
     |           |  +--ro org-openroadm-rstp:topo-change-count?        uint32
     |           |  +--ro org-openroadm-rstp:time-since-topo-change?   uint32
     |           +--ro org-openroadm-rstp:rstp-bridge-port-attr
     |              +--ro org-openroadm-rstp:rstp-bridge-port-table* [ifname]
     |                 +--ro org-openroadm-rstp:ifname                    string
     |                 +--ro org-openroadm-rstp:bridge-port-state?        enumeration
     |                 +--ro org-openroadm-rstp:bridge-port-role?         enumeration
     |                 +--ro org-openroadm-rstp:bridge-port-id?           uint32
     |                 +--ro org-openroadm-rstp:oper-edge-bridge-port?    empty
     |                 +--ro org-openroadm-rstp:designated-bridge-port?   uint32
     |                 +--ro org-openroadm-rstp:designated-bridgeid?      bridge-id-type
     +--ro internal-link* [internal-link-name]
     |  +--ro internal-link-name    string
     |  +--ro source
     |  |  +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--ro destination
     |     +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     +--rw physical-link* [physical-link-name]
     |  +--rw physical-link-name    string
     |  +--rw source
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--rw destination
     |     +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     +--rw external-link* [external-link-name]
     |  +--rw external-link-name    string
     |  +--rw source
     |  |  +--rw node-id              org-openroadm-common-types:node-id-type
     |  |  +--rw circuit-pack-name    string
     |  |  +--rw port-name            string
     |  +--rw destination
     |     +--rw node-id              org-openroadm-common-types:node-id-type
     |     +--rw circuit-pack-name    string
     |     +--rw port-name            string
     +--rw degree* [degree-number]
     |  +--rw degree-number       uint16
     |  +--ro max-wavelengths     uint16
     |  +--rw circuit-packs* [index]
     |  |  +--rw index                uint32
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  +--rw connection-ports* [index]
     |  |  +--rw index                uint32
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--rw otdr-port
     |  |  +--rw circuit-pack-name?   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name?           -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--ro mc-capabilities
     |     +--ro slot-width-granularity?    org-openroadm-common-types:frequency-GHz <50.0>
     |     +--ro center-freq-granularity?   org-openroadm-common-types:frequency-GHz <50.0>
     |     +--ro min-slots?                 uint32 <1>
     |     +--ro max-slots?                 uint32 <1>
     +--rw shared-risk-group* [srg-number]
     |  +--ro max-add-drop-ports                    uint16
     |  +--ro current-provisioned-add-drop-ports    uint16
     |  +--rw srg-number                            uint16
     |  +--ro wavelength-duplication                org-openroadm-common-types:wavelength-duplication-type
     |  +--rw circuit-packs* [index]
     |  |  +--rw index                uint32
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  +--ro mc-capabilities
     |     +--ro slot-width-granularity?    org-openroadm-common-types:frequency-GHz <50.0>
     |     +--ro center-freq-granularity?   org-openroadm-common-types:frequency-GHz <50.0>
     |     +--ro min-slots?                 uint32 <1>
     |     +--ro max-slots?                 uint32 <1>
     +--rw line-amplifier* [amp-number]
     |  +--rw amp-number                      uint8
     |  +--ro amp-type                        org-openroadm-common-types:amplifier-types
     |  +--rw control-mode?                   org-openroadm-common-types:line-amplifier-control-mode <off>
     |  +--ro amp-gain-range?                 org-openroadm-common-types:amplifier-gain-range <gain-range-1>
     |  +--rw target-gain?                    org-openroadm-common-types:ratio-dB
     |  +--rw target-tilt?                    org-openroadm-common-types:ratio-dB
     |  +--rw egress-average-channel-power?   org-openroadm-common-types:power-dBm
     |  +--ro out-voa-att?                    org-openroadm-common-types:ratio-dB
     |  +--ro partner-amp?                    -> ../amp-number
     |  +--rw ila-direction-label?            string
     |  +--rw circuit-pack* [index]
     |  |  +--rw index                uint32
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  +--rw line-port* [port-direction]
     |  |  +--rw port-direction                      org-openroadm-common-types:direction
     |  |  +--rw tx-instance-port-direction-label?   string
     |  |  +--rw rx-instance-port-direction-label?   string
     |  |  +--rw circuit-pack-name                   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name                           -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--rw osc-port* [port-direction]
     |  |  +--rw port-direction       org-openroadm-common-types:direction
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--rw otdr-port* [otdr-direction]
     |     +--rw otdr-direction       string
     |     +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     +--rw xponder* [xpdr-number]
     |  +--rw xpdr-number    uint16
     |  +--rw xpdr-type      org-openroadm-common-types:xpdr-node-types
     |  +--ro recolor?       boolean
     |  +--rw xpdr-port* [index]
     |     +--rw index                uint32
     |     +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |     +--rw eqpt-srg-id?         uint32
     +--rw roadm-connections* [connection-name]
     |  +--rw connection-name        string
     |  +--rw opticalControlMode?    org-openroadm-common-types:optical-control-mode <off>
     |  +--rw target-output-power?   org-openroadm-common-types:power-dBm
     |  +--rw source
     |  |  +--rw src-if    -> /org-openroadm-device/interface/name
     |  +--rw destination
     |     +--rw dst-if    -> /org-openroadm-device/interface/name
     +--rw odu-connection* [connection-name]
     |  +--rw connection-name    string
     |  +--rw direction?         enumeration <bidirectional>
     |  +--rw source
     |  |  +--rw src-if    -> /org-openroadm-device/interface/name
     |  +--rw destination
     |     +--rw dst-if    -> /org-openroadm-device/interface/name
     +--ro connection-map* [connection-map-number]
     |  +--ro connection-map-number    uint32
     |  +--ro source
     |  |  +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--ro destination* [circuit-pack-name port-name]
     |     +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     +--ro odu-switching-pools* [switching-pool-number]
        +--ro switching-pool-number    uint16
        +--ro switching-pool-type?     org-openroadm-switching-pool-types:switching-pool-types
        +--ro non-blocking-list* [nbl-number]
           +--ro nbl-number                      uint16
           +--ro interconnect-bandwidth-unit?    uint32
           +--ro interconnect-bandwidth?         uint32
           +--ro port-list* [circuit-pack-name port-name]
           |  +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
           |  +--ro port-name            -> /org-openroadm-device/circuit-packs/ports/port-name
           +--ro pluggable-optics-holder-list* [circuit-pack-name slot-name]
              +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
              +--ro slot-name            -> /org-openroadm-device/circuit-packs/cp-slots/slot-name

  rpcs:
    +---x led-control
    |  +---- input
    |  |  +---w (equipment-entity)
    |  |  |  +--:(shelf)
    |  |  |  |  +---w shelf-name    -> /org-openroadm-device/shelves/shelf-name
    |  |  |  +--:(circuit-pack)
    |  |  |     +---w circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
    |  |  +---w enabled              boolean
    |  +---- output
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    +---x create-tech-info
    |  +---- input
    |  |  +---w shelf-id?     -> /org-openroadm-device/shelves/shelf-name
    |  |  +---w log-option?   string
    |  +---- output
    |     +--ro shelf-id?         -> /org-openroadm-device/shelves/shelf-name
    |     +--ro log-file-name?    string
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    +---x get-connection-port-trail
    |  +---- input
    |  |  +---w connection-name    string
    |  +---- output
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    |     +--ro ports*
    |        +--ro rack?                string
    |        +--ro shelf?               string
    |        +--ro slot?                string
    |        +--ro subSlot?             string
    |        +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
    |        +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
    +---x disable-automatic-shutoff
    |  +---- input
    |  |  +---w (degree-or-amp)
    |  |  |  +--:(degree)
    |  |  |  |  +---w degree-number    -> /org-openroadm-device/degree/degree-number
    |  |  |  +--:(amp)
    |  |  |     +---w amp-number    -> /org-openroadm-device/line-amplifier/amp-number
    |  |  +---w support-timer?    uint16 <20>
    |  +---- output
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    +---x start-scan
    |  +---- input
    |  |  +---w (degree-or-amp)
    |  |  |  +--:(degree)
    |  |  |  |  +---w degree-number    -> /org-openroadm-device/degree/degree-number
    |  |  |  +--:(amp)
    |  |  |     +---w amp-number    -> /org-openroadm-device/line-amplifier/amp-number
    |  |  +---w port-direction?   org-openroadm-common-types:direction
    |  |  +---w distance?         uint32
    |  |  +---w resolution?       uint32
    |  +---- output
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    +---x set-current-datetime
       +---- input
       |  +---w current-datetime    ietf-yang-types:date-and-time
       +---- output
          +--ro status            org-openroadm-common-types:rpc-status
          +--ro status-message?   string

  notifications:
    +---n create-tech-info-notification
    |  +--ro shelf-id?         -> /org-openroadm-device/shelves/shelf-name
    |  +--ro log-file-name?    string
    |  +--ro status            org-openroadm-common-types:rpc-status
    |  +--ro status-message?   string
    +---n otdr-scan-result
    |  +--ro status         enumeration
    |  +--ro result-file?   string
    +---n change-notification
       +--ro change-time?   ietf-yang-types:date-and-time
       +--ro changed-by
       |  +--ro (server-or-user)?
       |     +--:(server)
       |     |  +--ro server?   empty
       |     +--:(by-user)
       |        +--ro username       org-openroadm-user-mgmt:username-type
       |        +--ro session-id     ietf-netconf:session-id-or-zero-type
       |        +--ro source-host?   ietf-inet-types:ip-address
       +--ro datastore?     enumeration <running>
       +--ro edit*
          +--ro target?      instance-identifier
          +--ro operation?   ietf-netconf:edit-operation-type

module: org-openroadm-network-media-channel-interfaces

  augment /org-openroadm-device:org-openroadm-device/org-openroadm-device:interface:
    +--rw nmc-ctp
    |  +--rw frequency?   org-openroadm-common-types:frequency-THz
    |  +--rw width?       org-openroadm-common-types:frequency-GHz

module: org-openroadm-ethernet-interfaces

  augment /org-openroadm-device:org-openroadm-device/org-openroadm-device:interface:
    +--rw ethernet
    |  +--rw speed?              uint32
    |  +--rw fec?                enumeration
    |  +--rw duplex?             enumeration <full>
    |  +--rw mtu?                uint32 <1522>
    |  +--rw auto-negotiation?   enumeration <enabled>
    |  +--ro curr-speed?         string
    |  +--ro curr-duplex?        string

module: org-openroadm-optical-channel-interfaces

  augment /org-openroadm-device:org-openroadm-device/org-openroadm-device:interface:
    +--rw och
    |  +--rw rate?                identityref
    |  +--rw frequency?           org-openroadm-common-types:frequency-THz
    |  +--ro width?               org-openroadm-common-types:frequency-GHz
    |  +--rw modulation-format?   org-openroadm-common-types:modulation-format
    |  +--rw transmit-power?      org-openroadm-common-types:power-dBm

module: org-openroadm-lldp

  augment /org-openroadm-device:org-openroadm-device/org-openroadm-device:protocols:
    +--rw lldp
    |  +--rw global-config
    |  |  +--rw adminStatus?           enumeration <enable>
    |  |  +--rw msgTxInterval?         uint16 <30>
    |  |  +--rw msgTxHoldMultiplier?   uint8 <4>
    |  +--rw port-config* [ifName]
    |  |  +--rw ifName         -> /org-openroadm-device:org-openroadm-device/org-openroadm-device:interface/org-openroadm-device:name
    |  |  +--rw adminStatus?   enumeration <txandrx>
    |  +--ro nbr-list
    |     +--ro if-name* [ifName]
    |        +--ro ifName                      string
    |        +--ro remoteSysName?              string
    |        +--ro remoteMgmtAddressSubType?   iana-afn-safi:address-family
    |        +--ro remoteMgmtAddress?          ietf-inet-types:ip-address
    |        +--ro remotePortIdSubType?        enumeration
    |        +--ro remotePortId?               string
    |        +--ro remoteChassisIdSubType?     enumeration
    |        +--ro remoteChassisId?            string

  notifications:
    +---n lldp-nbr-info-change
       +--ro notification-type?   org-openroadm-resource-types:resource-notification-type
       +--ro resource-type?       org-openroadm-resource-types:resource-type-enum
       +--ro resource?            string
       +--ro nbr-info
       |  +--ro remoteSysName?              string
       |  +--ro remoteMgmtAddressSubType?   iana-afn-safi:address-family
       |  +--ro remoteMgmtAddress?          ietf-inet-types:ip-address
       |  +--ro remotePortIdSubType?        enumeration
       |  +--ro remotePortId?               string
       |  +--ro remoteChassisIdSubType?     enumeration
       |  +--ro remoteChassisId?            string
       +--ro event-time?          ietf-yang-types:date-and-time

module: org-openroadm-optical-transport-interfaces

  augment /org-openroadm-device:org-openroadm-device/org-openroadm-device:interface:
    +--rw ots
    |  +--rw fiber-type?                       enumeration <smf>
    |  +--rw span-loss-receive?                org-openroadm-common-types:ratio-dB
    |  +--rw span-loss-transmit?               org-openroadm-common-types:ratio-dB
    |  +--rw ingress-span-loss-aging-margin?   org-openroadm-common-types:ratio-dB <0.0>
    |  +--rw eol-max-load-pIn?                 org-openroadm-common-types:power-dBm

module: org-openroadm-media-channel-interfaces

  augment /org-openroadm-device:org-openroadm-device/org-openroadm-device:interface:
    +--rw mc-ttp
    |  +--rw min-freq?      org-openroadm-common-types:frequency-THz
    |  +--rw max-freq?      org-openroadm-common-types:frequency-THz
    |  +--ro center-freq?   org-openroadm-common-types:frequency-THz
    |  +--ro slot-width?    org-openroadm-common-types:frequency-GHz

module: org-openroadm-otn-otu-interfaces

  augment /org-openroadm-device:org-openroadm-device/org-openroadm-device:interface:
    +--rw otu
    |  +--rw rate?                identityref
    |  +--rw fec?                 enumeration
    |  +--rw tx-sapi?             string
    |  +--rw tx-dapi?             string
    |  +--rw tx-operator?         string
    |  +--ro accepted-sapi?       string
    |  +--ro accepted-dapi?       string
    |  +--ro accepted-operator?   string
    |  +--rw expected-sapi?       string
    |  +--rw expected-dapi?       string
    |  +--rw tim-act-enabled?     boolean <false>
    |  +--rw tim-detect-mode?     enumeration <Disabled>
    |  +--rw degm-intervals?      uint8 <2>
    |  +--rw degthr-percentage?   uint16 <100>
    |  +--rw maint-loopback
    |     +--rw enabled?   boolean <false>
    |     +--rw type?      enumeration <fac>

module: org-openroadm-rstp

  augment /org-openroadm-device:org-openroadm-device/org-openroadm-device:protocols:
    +--rw rstp
       +--rw rstp-bridge-instance* [bridge-name]
          +--rw bridge-name    string
          +--rw rstp-config
          |  +--rw bridge-priority?          uint32 <32768>
          |  +--rw shutdown?                 empty
          |  +--rw hold-time?                uint32 <2>
          |  +--rw hello-time?               uint32 <2>
          |  +--rw max-age?                  uint32 <20>
          |  +--rw forward-delay?            uint32 <15>
          |  +--rw transmit-hold-count?      uint32 <2>
          |  +--rw rstp-bridge-port-table* [ifname]
          |     +--rw ifname      -> /org-openroadm-device:org-openroadm-device/org-openroadm-device:interface/org-openroadm-device:name
          |     +--rw cost?       uint32 <20000>
          |     +--rw priority?   uint32
          +--ro rstp-state
             +--ro rstp-bridge-attr
             |  +--ro root-bridge-port?         uint32
             |  +--ro root-path-cost?           uint32
             |  +--ro root-bridge-priority?     uint32
             |  +--ro root-bridge-id?           bridge-id-type
             |  +--ro root-hold-time?           uint32
             |  +--ro root-hello-time?          uint32
             |  +--ro root-max-age?             uint32
             |  +--ro root-forward-delay?       uint32
             |  +--ro bridge-id?                bridge-id-type
             |  +--ro topo-change-count?        uint32
             |  +--ro time-since-topo-change?   uint32
             +--ro rstp-bridge-port-attr
                +--ro rstp-bridge-port-table* [ifname]
                   +--ro ifname                    string
                   +--ro bridge-port-state?        enumeration
                   +--ro bridge-port-role?         enumeration
                   +--ro bridge-port-id?           uint32
                   +--ro oper-edge-bridge-port?    empty
                   +--ro designated-bridge-port?   uint32
                   +--ro designated-bridgeid?      bridge-id-type

  notifications:
    +---n rstp-topology-change
    |  +--ro node-id?   org-openroadm-common-types:node-id-type
    +---n rstp-new-root
       +--ro node-id?   org-openroadm-common-types:node-id-type

module: org-openroadm-otn-odu-interfaces

  augment /org-openroadm-device:org-openroadm-device/org-openroadm-device:interface:
    +--rw odu!
       +--rw rate?                                  identityref
       +--rw odu-function?                          identityref
       +--rw monitoring-mode?                       enumeration
       +--rw no-oam-function?                       empty
       +--rw proactive-delay-measurement-enabled?   boolean
       +--rw parent-odu-allocation!
       |  +--rw trib-port-number    uint16
       |  +--rw trib-slots*         uint16
       +--rw tx-sapi?                               string
       +--rw tx-dapi?                               string
       +--rw tx-operator?                           string
       +--ro accepted-sapi?                         string
       +--ro accepted-dapi?                         string
       +--ro accepted-operator?                     string
       +--rw expected-sapi?                         string
       +--rw expected-dapi?                         string
       +--rw tim-act-enabled?                       boolean <false>
       +--rw tim-detect-mode?                       enumeration <Disabled>
       +--rw degm-intervals?                        uint8 <2>
       +--rw degthr-percentage?                     uint16 <100>
       +--rw tcm* [layer tcm-direction]
       |  +--rw layer                                  uint8
       |  +--rw monitoring-mode?                       enumeration
       |  +--rw ltc-act-enabled?                       boolean
       |  +--rw proactive-delay-measurement-enabled?   boolean
       |  +--rw tcm-direction                          enumeration
       |  +--rw tx-sapi?                               string
       |  +--rw tx-dapi?                               string
       |  +--rw tx-operator?                           string
       |  +--ro accepted-sapi?                         string
       |  +--ro accepted-dapi?                         string
       |  +--ro accepted-operator?                     string
       |  +--rw expected-sapi?                         string
       |  +--rw expected-dapi?                         string
       |  +--rw tim-act-enabled?                       boolean <false>
       |  +--rw tim-detect-mode?                       enumeration <Disabled>
       |  +--rw degm-intervals?                        uint8 <2>
       |  +--rw degthr-percentage?                     uint16 <100>
       +--rw opu
       |  +--rw payload-type?        org-openroadm-otn-common-types:payload-type-def
