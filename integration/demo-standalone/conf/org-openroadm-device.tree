module: org-openroadm-device
  +--rw org-openroadm-device
     +--rw info
     |  +--rw node-id?                            org-openroadm-common-types:node-id-type <openroadm>
     |  +--rw node-number?                        uint32
     |  +--rw node-type?                          org-openroadm-common-types:node-types
     |  +--rw clli?                               string
     |  +--ro vendor                              string
     |  +--ro model                               string
     |  +--ro serial-id                           string
     |  +--rw ipAddress?                          ietf-inet-types:ip-address
     |  +--rw prefix-length?                      uint8
     |  +--rw defaultGateway?                     ietf-inet-types:ip-address
     |  +--ro source?                             enumeration
     |  +--ro current-ipAddress?                  ietf-inet-types:ip-address
     |  +--ro current-prefix-length?              uint8
     |  +--ro current-defaultGateway?             ietf-inet-types:ip-address
     |  +--ro macAddress?                         ietf-yang-types:mac-address
     |  +--ro softwareVersion?                    string
     |  +--ro openroadm-version?                  org-openroadm-common-types:openroadm-version-type
     |  +--rw template?                           string
     |  +--ro current-datetime?                   ietf-yang-types:date-and-time
     |  +--rw geoLocation
     |  |  +--rw latitude?    decimal64
     |  |  +--rw longitude?   decimal64
     |  +--ro max-degrees?                        uint16
     |  +--ro max-srgs?                           uint16
     |  +--ro max-num-bin-15min-historical-pm?    uint16
     |  +--ro max-num-bin-24hour-historical-pm?   uint16
     +--rw users
     |  +--rw user* [name]
     |     +--rw name        org-openroadm-user-mgmt:username-type
     |     +--rw password?   org-openroadm-user-mgmt:password-type
     |     +--rw group?      enumeration
     +--ro pending-sw
     |  +--ro sw-version?             string
     |  +--ro sw-validation-timer?    string
     |  +--ro activation-date-time?   ietf-yang-types:date-and-time
     +--rw shelves* [shelf-name]
     |  +--rw shelf-name              string
     |  +--rw shelf-type              string
     |  +--rw rack?                   string
     |  +--rw shelf-position?         string
     |  +--rw administrative-state?   org-openroadm-equipment-states-types:admin-states
     |  +--ro vendor                  string
     |  +--ro model                   string
     |  +--ro serial-id               string
     |  +--ro type?                   string
     |  +--ro product-code?           string
     |  +--ro manufacture-date?       ietf-yang-types:date-and-time
     |  +--ro clei?                   string
     |  +--ro hardware-version?       string
     |  +--ro operational-state?      org-openroadm-common-types:state
     |  +--rw equipment-state?        org-openroadm-equipment-states-types:states
     |  +--rw due-date?               ietf-yang-types:date-and-time
     |  +--ro slots* [slot-name]
     |     +--ro slot-name                   string
     |     +--ro label?                      string
     |     +--ro provisioned-circuit-pack?   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--ro slot-status?                enumeration
     +--rw circuit-packs* [circuit-pack-name]
     |  +--rw circuit-pack-type            string
     |  +--rw circuit-pack-product-code?   string
     |  +--rw circuit-pack-name            string
     |  +--rw administrative-state?        org-openroadm-equipment-states-types:admin-states
     |  +--ro vendor                       string
     |  +--ro model                        string
     |  +--ro serial-id                    string
     |  +--ro type?                        string
     |  +--ro product-code?                string
     |  +--ro manufacture-date?            ietf-yang-types:date-and-time
     |  +--ro clei?                        string
     |  +--ro hardware-version?            string
     |  +--ro operational-state?           org-openroadm-common-types:state
     |  +--ro circuit-pack-category
     |  |  +--ro type         org-openroadm-common-types:equipment-type-enum
     |  |  +--ro extension?   string
     |  +--rw equipment-state?             org-openroadm-equipment-states-types:states
     |  +--rw circuit-pack-mode?           string <NORMAL>
     |  +--rw shelf                        -> /org-openroadm-device/shelves/shelf-name
     |  +--rw slot                         string
     |  +--rw subSlot?                     string
     |  +--ro is-pluggable-optics          boolean
     |  +--rw due-date?                    ietf-yang-types:date-and-time
     |  +--rw parent-circuit-pack
     |  |  +--rw circuit-pack-name?   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw cp-slot-name?        string
     |  +--ro cp-slots* [slot-name]
     |  |  +--ro slot-name                   string
     |  |  +--ro label?                      string
     |  |  +--ro provisioned-circuit-pack?   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--ro slot-status?                enumeration
     |  |  +--ro slot-type?                  enumeration
     |  +--ro software-load-version?       string
     |  +--ro circuit-pack-features*
     |  |  +--ro feature
     |  |     +--ro description?   string
     |  |     +--ro activated?     boolean
     |  +--ro circuit-pack-components*
     |  |  +--ro component
     |  |     +--ro name?               string
     |  |     +--ro current-version?    string
     |  |     +--ro version-to-apply?   string
     |  +--rw ports* [port-name]
     |     +--rw port-name                         string
     |     +--rw port-type?                        string
     |     +--rw port-qual?                        org-openroadm-common-types:port-qual
     |     +--ro port-wavelength-type?             org-openroadm-port-types:port-wavelength-types
     |     +--ro port-direction                    org-openroadm-common-types:direction
     |     +--ro label?                            string
     |     +--rw circuit-id?                       string
     |     +--rw administrative-state?             org-openroadm-equipment-states-types:admin-states <outOfService>
     |     +--ro operational-state                 org-openroadm-common-types:state
     |     +--ro supported-interface-capability*   identityref
     |     +--rw logical-connection-point?         string
     |     +--ro partner-port
     |     |  +--ro circuit-pack-name?   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     |  +--ro port-name?           -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |     +--ro parent-port
     |     |  +--ro circuit-pack-name?   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     |  +--ro port-name?           -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |     +--ro interfaces*
     |     |  +--ro interface-name?   -> /org-openroadm-device/interface/name
     |     +--rw roadm-port
     |     |  +--ro port-power-capability-min-rx?   org-openroadm-common-types:power-dBm
     |     |  +--ro port-power-capability-min-tx?   org-openroadm-common-types:power-dBm
     |     |  +--ro port-power-capability-max-rx?   org-openroadm-common-types:power-dBm
     |     |  +--ro port-power-capability-max-tx?   org-openroadm-common-types:power-dBm
     |     +--rw transponder-port
     |     |  +--ro port-power-capability-min-rx?   org-openroadm-common-types:power-dBm
     |     |  +--ro port-power-capability-min-tx?   org-openroadm-common-types:power-dBm
     |     |  +--ro port-power-capability-max-rx?   org-openroadm-common-types:power-dBm
     |     |  +--ro port-power-capability-max-tx?   org-openroadm-common-types:power-dBm
     |     +--rw otdr-port
     |     |  +--rw launch-cable-length?   uint32 <30>
     |     |  +--rw port-direction?        org-openroadm-common-types:direction
     |     +--rw ila-port
     |        +--ro port-power-capability-min-rx?   org-openroadm-common-types:power-dBm
     |        +--ro port-power-capability-min-tx?   org-openroadm-common-types:power-dBm
     |        +--ro port-power-capability-max-rx?   org-openroadm-common-types:power-dBm
     |        +--ro port-power-capability-max-tx?   org-openroadm-common-types:power-dBm
     +--rw interface* [name]
     |  +--rw name                            string
     |  +--rw description?                    string
     |  +--rw type                            identityref
     |  +--rw administrative-state?           org-openroadm-equipment-states-types:admin-states
     |  +--ro operational-state?              org-openroadm-common-types:state
     |  +--rw circuit-id?                     string
     |  +--rw supporting-interface?           -> /org-openroadm-device/interface/name
     |  +--rw supporting-circuit-pack-name?   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  +--rw supporting-port?                -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../supporting-circuit-pack-name]/ports/port-name
     +--rw protection-grps
     +--rw protocols
     +--ro internal-link* [internal-link-name]
     |  +--ro internal-link-name    string
     |  +--ro source
     |  |  +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--ro destination
     |     +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     +--rw physical-link* [physical-link-name]
     |  +--rw physical-link-name    string
     |  +--rw source
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--rw destination
     |     +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     +--rw external-link* [external-link-name]
     |  +--rw external-link-name    string
     |  +--rw source
     |  |  +--rw node-id              org-openroadm-common-types:node-id-type
     |  |  +--rw circuit-pack-name    string
     |  |  +--rw port-name            string
     |  +--rw destination
     |     +--rw node-id              org-openroadm-common-types:node-id-type
     |     +--rw circuit-pack-name    string
     |     +--rw port-name            string
     +--rw degree* [degree-number]
     |  +--rw degree-number       uint16
     |  +--ro max-wavelengths     uint16
     |  +--rw circuit-packs* [index]
     |  |  +--rw index                uint32
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  +--rw connection-ports* [index]
     |  |  +--rw index                uint32
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--rw otdr-port
     |  |  +--rw circuit-pack-name?   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name?           -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--ro mc-capabilities
     |     +--ro slot-width-granularity?    org-openroadm-common-types:frequency-GHz <50.0>
     |     +--ro center-freq-granularity?   org-openroadm-common-types:frequency-GHz <50.0>
     |     +--ro min-slots?                 uint32 <1>
     |     +--ro max-slots?                 uint32 <1>
     +--rw shared-risk-group* [srg-number]
     |  +--ro max-add-drop-ports                    uint16
     |  +--ro current-provisioned-add-drop-ports    uint16
     |  +--rw srg-number                            uint16
     |  +--ro wavelength-duplication                org-openroadm-common-types:wavelength-duplication-type
     |  +--rw circuit-packs* [index]
     |  |  +--rw index                uint32
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  +--ro mc-capabilities
     |     +--ro slot-width-granularity?    org-openroadm-common-types:frequency-GHz <50.0>
     |     +--ro center-freq-granularity?   org-openroadm-common-types:frequency-GHz <50.0>
     |     +--ro min-slots?                 uint32 <1>
     |     +--ro max-slots?                 uint32 <1>
     +--rw line-amplifier* [amp-number]
     |  +--rw amp-number                      uint8
     |  +--ro amp-type                        org-openroadm-common-types:amplifier-types
     |  +--rw control-mode?                   org-openroadm-common-types:line-amplifier-control-mode <off>
     |  +--ro amp-gain-range?                 org-openroadm-common-types:amplifier-gain-range <gain-range-1>
     |  +--rw target-gain?                    org-openroadm-common-types:ratio-dB
     |  +--rw target-tilt?                    org-openroadm-common-types:ratio-dB
     |  +--rw egress-average-channel-power?   org-openroadm-common-types:power-dBm
     |  +--ro out-voa-att?                    org-openroadm-common-types:ratio-dB
     |  +--ro partner-amp?                    -> ../amp-number
     |  +--rw ila-direction-label?            string
     |  +--rw circuit-pack* [index]
     |  |  +--rw index                uint32
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  +--rw line-port* [port-direction]
     |  |  +--rw port-direction                      org-openroadm-common-types:direction
     |  |  +--rw tx-instance-port-direction-label?   string
     |  |  +--rw rx-instance-port-direction-label?   string
     |  |  +--rw circuit-pack-name                   -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name                           -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--rw osc-port* [port-direction]
     |  |  +--rw port-direction       org-openroadm-common-types:direction
     |  |  +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--rw otdr-port* [otdr-direction]
     |     +--rw otdr-direction       string
     |     +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     +--rw xponder* [xpdr-number]
     |  +--rw xpdr-number    uint16
     |  +--rw xpdr-type      org-openroadm-common-types:xpdr-node-types
     |  +--ro recolor?       boolean
     |  +--rw xpdr-port* [index]
     |     +--rw index                uint32
     |     +--rw circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--rw port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |     +--rw eqpt-srg-id?         uint32
     +--rw roadm-connections* [connection-name]
     |  +--rw connection-name        string
     |  +--rw opticalControlMode?    org-openroadm-common-types:optical-control-mode <off>
     |  +--rw target-output-power?   org-openroadm-common-types:power-dBm
     |  +--rw source
     |  |  +--rw src-if    -> /org-openroadm-device/interface/name
     |  +--rw destination
     |     +--rw dst-if    -> /org-openroadm-device/interface/name
     +--rw odu-connection* [connection-name]
     |  +--rw connection-name    string
     |  +--rw direction?         enumeration <bidirectional>
     |  +--rw source
     |  |  +--rw src-if    -> /org-openroadm-device/interface/name
     |  +--rw destination
     |     +--rw dst-if    -> /org-openroadm-device/interface/name
     +--ro connection-map* [connection-map-number]
     |  +--ro connection-map-number    uint32
     |  +--ro source
     |  |  +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |  |  +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     |  +--ro destination* [circuit-pack-name port-name]
     |     +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
     |     +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
     +--ro odu-switching-pools* [switching-pool-number]
        +--ro switching-pool-number    uint16
        +--ro switching-pool-type?     org-openroadm-switching-pool-types:switching-pool-types
        +--ro non-blocking-list* [nbl-number]
           +--ro nbl-number                      uint16
           +--ro interconnect-bandwidth-unit?    uint32
           +--ro interconnect-bandwidth?         uint32
           +--ro port-list* [circuit-pack-name port-name]
           |  +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
           |  +--ro port-name            -> /org-openroadm-device/circuit-packs/ports/port-name
           +--ro pluggable-optics-holder-list* [circuit-pack-name slot-name]
              +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
              +--ro slot-name            -> /org-openroadm-device/circuit-packs/cp-slots/slot-name

  rpcs:
    +---x led-control
    |  +---- input
    |  |  +---w (equipment-entity)
    |  |  |  +--:(shelf)
    |  |  |  |  +---w shelf-name    -> /org-openroadm-device/shelves/shelf-name
    |  |  |  +--:(circuit-pack)
    |  |  |     +---w circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
    |  |  +---w enabled              boolean
    |  +---- output
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    +---x create-tech-info
    |  +---- input
    |  |  +---w shelf-id?     -> /org-openroadm-device/shelves/shelf-name
    |  |  +---w log-option?   string
    |  +---- output
    |     +--ro shelf-id?         -> /org-openroadm-device/shelves/shelf-name
    |     +--ro log-file-name?    string
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    +---x get-connection-port-trail
    |  +---- input
    |  |  +---w connection-name    string
    |  +---- output
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    |     +--ro ports*
    |        +--ro rack?                string
    |        +--ro shelf?               string
    |        +--ro slot?                string
    |        +--ro subSlot?             string
    |        +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
    |        +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
    +---x disable-automatic-shutoff
    |  +---- input
    |  |  +---w (degree-or-amp)
    |  |  |  +--:(degree)
    |  |  |  |  +---w degree-number    -> /org-openroadm-device/degree/degree-number
    |  |  |  +--:(amp)
    |  |  |     +---w amp-number    -> /org-openroadm-device/line-amplifier/amp-number
    |  |  +---w support-timer?    uint16 <20>
    |  +---- output
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    +---x start-scan
    |  +---- input
    |  |  +---w (degree-or-amp)
    |  |  |  +--:(degree)
    |  |  |  |  +---w degree-number    -> /org-openroadm-device/degree/degree-number
    |  |  |  +--:(amp)
    |  |  |     +---w amp-number    -> /org-openroadm-device/line-amplifier/amp-number
    |  |  +---w port-direction?   org-openroadm-common-types:direction
    |  |  +---w distance?         uint32
    |  |  +---w resolution?       uint32
    |  +---- output
    |     +--ro status            org-openroadm-common-types:rpc-status
    |     +--ro status-message?   string
    +---x set-current-datetime
       +---- input
       |  +---w current-datetime    ietf-yang-types:date-and-time
       +---- output
          +--ro status            org-openroadm-common-types:rpc-status
          +--ro status-message?   string

  notifications:
    +---n create-tech-info-notification
    |  +--ro shelf-id?         -> /org-openroadm-device/shelves/shelf-name
    |  +--ro log-file-name?    string
    |  +--ro status            org-openroadm-common-types:rpc-status
    |  +--ro status-message?   string
    +---n otdr-scan-result
    |  +--ro status         enumeration
    |  +--ro result-file?   string
    +---n change-notification
       +--ro change-time?   ietf-yang-types:date-and-time
       +--ro changed-by
       |  +--ro (server-or-user)?
       |     +--:(server)
       |     |  +--ro server?   empty
       |     +--:(by-user)
       |        +--ro username       org-openroadm-user-mgmt:username-type
       |        +--ro session-id     ietf-netconf:session-id-or-zero-type
       |        +--ro source-host?   ietf-inet-types:ip-address
       +--ro datastore?     enumeration <running>
       +--ro edit*
          +--ro target?      instance-identifier
          +--ro operation?   ietf-netconf:edit-operation-type
