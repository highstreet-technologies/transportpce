     |  |  +--ro port-name                   string
     |  |  +--ro otsi-rate?                  identityref
     |  |  +--ro optical-operational-mode*   -> /org-openroadm-device/optical-operational-mode-profile/profile-name
     |  +--ro otsigroup-capability-profile-name*   -> /org-openroadm-device/otsigroup-capability-profile/profile-name
     +--ro otn-odu-mux-hierarchy-profile* [profile-name]
     |  +--ro profile-name      string
     |  +--ro mux-capability* [stage-number ho-odu-type ho-odu-payload-type]
     |     +--ro stage-number                       uint8
     |     +--ro ho-odu-type                        identityref
     |     +--ro ho-odu-payload-type                org-openroadm-otn-common-types:payload-type-def
     |     +--ro supported-lo-odu-type*             identityref
     |     +--ro lo-odu-proactive-DMp?              boolean
     |     +--ro lo-odu-tcm-capable?                boolean
     |     +--ro lo-odu-proactive-DMt?              boolean
     |     +--ro lo-odu-tcm-direction-capability?   org-openroadm-common-types:tcm-direction-capability-type
     +--ro optical-operational-mode-profile* [profile-name]
     |  +--ro profile-name      string
     |  +--ro spectral-width?   org-openroadm-common-optical-channel-types:frequency-GHz
     +--ro otn-capability-profile* [profile-name]
     |  +--ro profile-name                string
     |  +--ro if-protection-capability*   identityref
     |  +--ro proactive-DMp?              boolean
     |  +--ro tcm-capable?                boolean
     |  +--ro proactive-DMt?              boolean
     |  +--ro tcm-direction-capability?   org-openroadm-common-types:tcm-direction-capability-type
     |  +--ro opu-payload-type-mapping*   org-openroadm-otn-common-types:payload-type-def
     +--ro muxp-profile* [profile-name]
        +--ro profile-name                       string
        +--ro odtu-type                          identityref
        +--ro network-odu-rate                   identityref
        +--ro network-oducn-n-rate?              uint16
        +--ro network-ho-odu-trib-port-number    uint16
        +--ro network-ho-odu-trib-slots*         uint16
        +--ro network-ho-odu-opucn-trib-slots*   org-openroadm-otn-common-types:opucn-trib-slot-def

  rpcs:
    +---x led-control
    |  +---w input
    |  |  +---w (equipment-entity)
    |  |  |  +--:(shelf)
    |  |  |  |  +---w shelf-name           -> /org-openroadm-device/shelves/shelf-name
    |  |  |  +--:(circuit-pack)
    |  |  |     +---w circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
    |  |  +---w enabled                    boolean
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x create-tech-info
    |  +---w input
    |  |  +---w shelf-id?     -> /org-openroadm-device/shelves/shelf-name
    |  |  +---w log-option?   string
    |  +--ro output
    |     +--ro shelf-id?         -> /org-openroadm-device/shelves/shelf-name
    |     +--ro log-file-name?    string
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x get-connection-port-trail
    |  +---w input
    |  |  +---w connection-name    string
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    |     +--ro ports* []
    |        +--ro rack?                string
    |        +--ro shelf?               string
    |        +--ro slot?                string
    |        +--ro subSlot?             string
    |        +--ro circuit-pack-name    -> /org-openroadm-device/circuit-packs/circuit-pack-name
    |        +--ro port-name            -> /org-openroadm-device/circuit-packs[circuit-pack-name=current()/../circuit-pack-name]/ports/port-name
    +---x disable-automatic-shutoff
    |  +---w input
    |  |  +---w (degree-or-amp)
    |  |  |  +--:(degree)
    |  |  |  |  +---w degree-number    -> /org-openroadm-device/degree/degree-number
    |  |  |  +--:(amp)
    |  |  |     +---w amp-number       -> /org-openroadm-device/line-amplifier/amp-number
    |  |  +---w support-timer?         uint16
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x start-scan
    |  +---w input
    |  |  +---w (degree-or-amp)
    |  |  |  +--:(degree)
    |  |  |  |  +---w degree-number    -> /org-openroadm-device/degree/degree-number
    |  |  |  +--:(amp)
    |  |  |     +---w amp-number       -> /org-openroadm-device/line-amplifier/amp-number
    |  |  +---w port-direction?        org-openroadm-common-alarm-pm-types:direction
    |  |  +---w distance?              uint32
    |  |  +---w resolution?            uint32
    |  +--ro output
    |     +--ro status            rpc-status
    |     +--ro status-message?   string
    +---x set-current-datetime
       +---w input
       |  +---w current-datetime    ietf-yang-types:date-and-time
       +--ro output
          +--ro status            rpc-status
          +--ro status-message?   string

  notifications:
    +---n create-tech-info-notification
    |  +--ro shelf-id?         -> /org-openroadm-device/shelves/shelf-name
    |  +--ro log-file-name?    string
    |  +--ro status            rpc-status
    |  +--ro status-message?   string
    +---n otdr-scan-result
    |  +--ro status            rpc-status
    |  +--ro status-message?   string
    |  +--ro result-file?      string
    +---n change-notification
       +--ro change-time?   ietf-yang-types:date-and-time
       +--ro changed-by
       |  +--ro (server-or-user)?
       |     +--:(server)
       |     |  +--ro server?        empty
       |     +--:(by-user)
       |        +--ro username       org-openroadm-user-mgmt:username-type
       |        +--ro session-id     ietf-nc:session-id-or-zero-type
       |        +--ro source-host?   ietf-inet-types:ip-address
       +--ro datastore?     enumeration
       +--ro edit* []
          +--ro target?      instance-identifier
          +--ro operation?   ietf-nc:edit-operation-type

